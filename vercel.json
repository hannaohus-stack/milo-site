{
  "redirects": [
    {
      "source": "/",
      "destination": "/coming-soon/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/coming-soon/",
      "permanent": false
    },
    {
      "source": "/ai-team(/.*)?",
      "destination": "/coming-soon/",
      "permanent": false
    },
    {
      "source": "/ai-branding(/.*)?",
      "destination": "/coming-soon/",
      "permanent": false
    },
    {
      "source": "/ai-visual(/.*)?",
      "destination": "/coming-soon/",
      "permanent": false
    },
    {
      "source": "/service(/.*)?",
      "destination": "/coming-soon/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
